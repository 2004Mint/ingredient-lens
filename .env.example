# 成分镜 · 环境变量模板
#
# 说明：
# 1. 本项目**不会自动读取 .env**。这里只是环境变量清单，真正生效的方式是
#    系统环境变量（PowerShell: $env:NAME="..."）或 start-server.bat 里设置。
# 2. 真实 Key 请只放在本机环境变量或 ~/.cosme/data/ai-settings.json，
#    不要提交到仓库（.env 已在 .gitignore 里）。
# 3. 视觉 / 研究留空的字段会逐项回退到「总 API」。

# ---------- 总 API（OpenAI 兼容） ----------
AI_BASE_URL=https://your-provider.example.com/v1
AI_API_KEY=sk-your-key
AI_MODEL=your-text-model

# 兼容旧变量名：AI_* 为空时才会读取 OPENAI_*
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ---------- 视觉模型（拍标签，必须支持图片输入） ----------
# 留空则回退总 API；模型示例：qwen-vl-plus / gpt-4o-mini
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ---------- 研究模型（补全未收录成分，建议支持 JSON 输出） ----------
# 留空则回退总 API
RESEARCH_BASE_URL=
RESEARCH_API_KEY=
RESEARCH_MODEL=

# ---------- 管理台与 MCP ----------
# 管理台密码；不设置会自动生成到 ~/.cosme/data/admin-password.txt
ADMIN_PASSWORD=
# MCP 写入口令牌；不设置则 /api/mcp/research 整个关闭（只读工具不受影响）
COSME_MCP_TOKEN=

# ---------- 数据与端口 ----------
# 数据目录，默认 ~/.cosme/data
COSME_DATA_DIR=
# 后端端口，默认 8082
SERVER_PORT=8082

# ---------- 前端开发代理（Vite） ----------
# 后端换端口时改这里，例如 http://127.0.0.1:8083
COSME_API=http://127.0.0.1:8082

# ---------- MCP server 连接的后端 ----------
COSME_BACKEND=http://127.0.0.1:8082
