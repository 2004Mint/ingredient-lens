# 构建产物
server/target/
web/node_modules/
web/dist/
dist/

# 运行时日志
server/run*.log
server/run*.err

# 本地数据目录（含视觉 Key、管理密码、分享报告）
# 统一由 DataPaths 解析到 ~/.cosme/data；仓库内这两个路径是历史遗留，仍然禁止提交
server/data/
data/

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# 密钥（严禁提交）
.env
.env.local
*.local

# 视频工具链与中间产物：ffmpeg 静态包、capture-director 克隆都是第三方内容，不入库
tools/
video/out/
video/audio/
video/shots/out/
video/sub/

# 沙箱 ACL 恢复备份（环境相关，非项目内容）
.acl-recovery/

# 文档截图脚本（一次性工具）
.docgen/

# 视频流水线：字体、日志、临时变体与生成物
video/msyh.ttc
video/*.log
video/fix2.ps1
video/demo.srt
video/durations.json